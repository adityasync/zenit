# Redis Cloud (free tier)
REDIS_URL=redis://default:your-password@your-redis-host:6379

# Upstox API (free tier - https://developer.upstox.com/)
UPSTOX_API_KEY=your_api_key
UPSTOX_ACCESS_TOKEN=your_access_token

# ICICI Breeze API (free - https://www.icicidirect.com/breeze-api)
ICICI_BREEZE_API_KEY=your_api_key
ICICI_BREEZE_CLIENT_ID=your_client_id
ICICI_BREEZE_PASSWORD=your_password

# Anthropic Claude API (for AI Copilot)
ANTHROPIC_API_KEY=your_api_key

# Node environment
NODE_ENV=development
